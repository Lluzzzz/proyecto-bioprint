erDiagram
    CASO_ESTUDIO ||--o{ ESCENARIO : posee
    ESCENARIO ||--o{ SIMULACION : genera
    SIMULACION ||--o{ EJECUCION_METODO : incluye
    EJECUCION_METODO ||--o{ ITERACION_RESULTADO : registra
    EJECUCION_METODO ||--o| RESULTADO_RESUMEN : resume
    CASO_ESTUDIO {
      int id PK
      string codigo UK
      string nombre
      string modelo_version
    }
    ESCENARIO {
      int id PK
      int caso_id FK
      string tipo
      string parametros_json
      string fuente_datos
    }
    SIMULACION {
      int id PK
      int escenario_id FK
      datetime fecha
      string estado
    }
    EJECUCION_METODO {
      int id PK
      int simulacion_id FK
      string metodo
      float tolerancia
      int iteraciones
      bool convergio
    }
    ITERACION_RESULTADO {
      int id PK
      int ejecucion_id FK
      int numero
      float residual
      float error_abs
    }
    RESULTADO_RESUMEN {
      int id PK
      int ejecucion_id FK UK
      string valor_json
      string conclusion_numerica
      string conclusion_problema
    }
